# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────
# Either a full connection string (Neon, Render, RDS, …) …
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# … or individual local Postgres vars (used only when DATABASE_URL is unset)
# DB_USER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=playsuper
# DB_PASSWORD=postgres

# ── Auth (Clerk) ────────────────────────────────────────
# From the Clerk dashboard: API Keys -> Secret key
CLERK_SECRET_KEY=change-me-in-production
# Comma-separated frontend origins allowed to use our session tokens
# (defaults to CLIENT_ORIGIN)
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# ── Economy ─────────────────────────────────────────────
# 100 Sparks = Rs 1 (1 Spark = 1 paisa). Integer math only.
WELCOME_BONUS_SPARKS=2500
MAX_EARN_PER_EVENT=2500

# ── Payments ────────────────────────────────────────────
# PROVIDER: "mock" (default, simulated gateway) | "razorpay"
PAYMENT_PROVIDER=mock
# Razorpay credentials (only needed when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
