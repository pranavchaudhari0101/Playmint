# ── Server ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ── Database ────────────────────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=playsuper
DB_PASSWORD=postgres

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ── Economy ─────────────────────────────────────────────
# 100 Sparks = Rs 1 (1 Spark = 1 paisa). Integer math only.
WELCOME_BONUS_SPARKS=2500
MAX_EARN_PER_EVENT=2500

# ── Payments ────────────────────────────────────────────
# PROVIDER: "mock" (default, simulated gateway) | "razorpay"
PAYMENT_PROVIDER=mock
# Razorpay credentials (only needed when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
